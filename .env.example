# ==============================================================================
# SEC-AUDIT ENTERPRISE - SERMIG 2026
# Plantilla de Configuración de Variables de Entorno (Sin Credenciales Reales)
# ==============================================================================

# Entorno y Aplicación
APP_NAME="SEC-AUDIT SERMIG Enterprise"
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=cambiar_por_clave_segura_hexadecimal_64_caracteres
API_PREFIX=/api/v1

# Base de Datos PostgreSQL
DB_HOST=postgres_sec_audit
DB_PORT=5432
DB_NAME=sec_audit_db
DB_USER=sec_audit_user
DB_PASSWORD=ConfigurarPasswordRobustoPostgres

# Redis / Cola Celery
REDIS_HOST=redis_sec_audit
REDIS_PORT=6379
REDIS_PASSWORD=ConfigurarPasswordRobustoRedis
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1

# Conectividad Cloud - Microsoft Azure (Service Principal con rol Security Reader)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# Conectividad Cloud - Oracle Cloud Infrastructure (OCI) (Auditor / Read-Only)
OCI_USER_OCID=
OCI_KEY_FINGERPRINT=
OCI_KEY_FILE_PATH=/app/config/keys/oci_api_key.pem
OCI_TENANCY_OCID=
OCI_REGION=sa-santiago-1

# Límites de Escaneo y Seguridad (Anti-DoS / Scope Restriction)
MAX_CONCURRENT_SCANS=4
DEFAULT_SCAN_RATE_LIMIT=50
REQUIRE_EXPLICIT_SCOPE_APPROVAL=true
